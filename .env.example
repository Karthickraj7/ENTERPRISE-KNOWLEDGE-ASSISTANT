# =============================================================================
# Enterprise Knowledge Assistant - Environment Configuration Template
# Copy to .env for local development: cp .env.example .env
# Never commit real secrets or API keys to version control.
# =============================================================================

# --- Application & Environment ---
APP_NAME="Enterprise Knowledge Assistant"
APP_ENV=development
APP_VERSION=2.0.0
API_HOST=0.0.0.0
API_PORT=8000
WEB_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# --- Database (PostgreSQL + pgvector in Docker/Prod, or SQLite for lightweight local test) ---
DATABASE_URL=postgresql+psycopg://eka_user:eka_local_dev_password@localhost:5432/eka_db

# --- Authentication & Session Security ---
SESSION_SECRET_KEY=replace-with-64-char-hex-secret-in-production-0123456789abcdef
CSRF_SECRET_KEY=replace-with-64-char-hex-csrf-secret-in-production-abcdef012345
SESSION_COOKIE_NAME=eka_session
SESSION_IDLE_TTL_SECONDS=28800
SESSION_ABSOLUTE_TTL_SECONDS=86400
COOKIE_SECURE=false

# Google OIDC (Authorization Code Flow + PKCE + State + Nonce)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
GOOGLE_OIDC_DISCOVERY_URL=https://accounts.google.com/.well-known/openid-configuration
ALLOWED_EMAIL_DOMAINS=example.com,acme-corp.internal

# Isolated Local Development Login (MUST be false in staging/production)
ENABLE_DEV_AUTH=true
DEFAULT_TENANT_SLUG=acme-enterprise
DEFAULT_TENANT_NAME="Acme Enterprise Knowledge Base"

# --- Object Storage (local | s3) ---
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./var/storage
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=eka-documents-private
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MAX_UPLOAD_SIZE_MB=25

# --- Free-First Embedding Configuration (Local by Default) ---
# Supported: sentence_transformers | gemini | openai | mock
EMBEDDING_PROVIDER=sentence_transformers
# Default English model (384 dims, MIT). Multilingual swap-in: intfloat/multilingual-e5-small
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_REVISION=main
EMBEDDING_DIM=384
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_S=30

# --- Optional Generation Provider (Disabled / Retrieval-Only by Default) ---
# Supported: none | openai_compatible | gemini | openai | anthropic | mock
GENERATION_PROVIDER=none
# Never hardcode runtime model IDs in code. Set explicitly when enabling a provider:
# e.g. gemini-2.5-flash or gemini-3.8-flash (verify at ai.google.dev/gemini-api/docs/models)
GENERATION_MODEL=
GENERATION_BASE_URL=http://localhost:8080/v1
GENERATION_TIMEOUT_S=45
MAX_CONTEXT_TOKENS=3000
MAX_OUTPUT_TOKENS=768
PROVIDER_CONCURRENCY=4

# Data Governance Guardrail: blocks providers where data_used_for_training=true
ALLOW_TRAINING_USE_PROVIDERS=false
GEMINI_TIER_IS_FREE=true

# Optional Provider Secrets (Backend-only; never exposed to browser)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Hybrid Retrieval & Chunking Parameters ---
CHUNK_TARGET_TOKENS=350
CHUNK_OVERLAP_TOKENS=50
RETRIEVAL_TOP_K=6
RRF_K=60
VECTOR_WEIGHT=1.0
FTS_WEIGHT=1.0
MIN_EVIDENCE_SCORE=0.012

# --- Quotas & Rate Limits ---
RATE_LIMIT_REQUESTS_PER_MINUTE=60
TENANT_STORAGE_QUOTA_MB=500
